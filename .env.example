# Guardar la copia real en ~/ocasion-dom2/.env de Ubuntu, con permisos 600.
# No ejecutar este archivo con source; lo lee Docker Compose.
DOM2_BIND_IP=172.30.219.232
# 8083 evita el 8081 que anteriormente ocupaba Mongo Express en esta VM.
DOM2_HOST_PORT=8083
DOM2_DOCKER_NETWORK=ocasion-dom2-net
DOM2_DB_CONTAINER=ocasion_db_dom2

# Puerto interno de MySQL; no es el puerto publicado en Ubuntu.
DB_URL=jdbc:mysql://ocasion_db_dom2:3306/ocasion_salon_db?serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8
DB_USERNAME=REEMPLAZAR_USUARIO_MYSQL
DB_PASSWORD='REEMPLAZAR_CONTRASENA_MYSQL'
# Conservar exactamente el secreto compartido actual con DOM1; no generar otro.
JWT_SECRET='REEMPLAZAR_MISMO_SECRETO_JWT_ACTUAL'
JPA_DDL_AUTO=update
SHOW_SQL=false
